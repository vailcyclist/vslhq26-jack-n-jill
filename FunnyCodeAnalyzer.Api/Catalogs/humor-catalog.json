{
  "version": "2.0",
  "defaultCulture": "en-US",
  "defaults": {
    "humorLevel": "lightHearted",
    "topic": "general",
    "channel": "teams",
    "fallbackTopic": "general",
    "fallbackHumorLevel": "lightHearted",
    "allowAdultHumor": false,
    "allowSarcasm": true,
    "allowInsults": false
  },
  "humorLevels": {
    "kidFriendly": {
      "displayName": "Kid-Friendly",
      "description": "Silly, safe, playful, no sarcasm or adult references.",
      "allowSarcasm": false,
      "allowMildInsults": false,
      "allowProfanity": false,
      "maxSpice": 0
    },
    "lightHearted": {
      "displayName": "Light-Hearted",
      "description": "Friendly workplace humor with gentle teasing.",
      "allowSarcasm": false,
      "allowMildInsults": false,
      "allowProfanity": false,
      "maxSpice": 1
    },
    "average": {
      "displayName": "Average",
      "description": "Casual developer humor with mild sarcasm.",
      "allowSarcasm": true,
      "allowMildInsults": false,
      "allowProfanity": false,
      "maxSpice": 2
    },
    "sarcastic": {
      "displayName": "Sarcastic",
      "description": "Dry humor and stronger teasing, still workplace-safe.",
      "allowSarcasm": true,
      "allowMildInsults": true,
      "allowProfanity": false,
      "maxSpice": 3
    },
    "spicy": {
      "displayName": "Spicy",
      "description": "More dramatic, snarky, and chaotic, but no profanity.",
      "allowSarcasm": true,
      "allowMildInsults": true,
      "allowProfanity": false,
      "maxSpice": 4
    },
    "dirty": {
      "displayName": "Dirty",
      "description": "Adult humor. Disabled by default. Use carefully.",
      "allowSarcasm": true,
      "allowMildInsults": true,
      "allowProfanity": true,
      "maxSpice": 5
    }
  },
